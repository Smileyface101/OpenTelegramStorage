# Copy to .env next to docker-compose.yml. All settings are optional.

# Master key for encrypting Telegram credentials at rest (64 hex chars).
# If unset, one is generated in the data volume on first start (data/master.key).
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
#OTS_MASTER_KEY=

# Host port to publish the web UI on.
OTS_PORT=8080

# Set to true when the app is served over HTTPS (behind Caddy/nginx/Cloudflare),
# so cookies get the Secure flag. Leave unset to auto-detect from the request.
#OTS_COOKIE_SECURE=true

# Reverse proxies in front of the app (count from the right of X-Forwarded-For).
# 0 = none (default), 1 = one nginx/Caddy, 2 = Cloudflare -> nginx.
OTS_TRUSTED_PROXY_COUNT=0

# Default part size for splitting large files (MB). Max 1990. Changeable in the UI.
OTS_DEFAULT_PART_SIZE_MB=512

OTS_LOG_LEVEL=INFO
